# Core bot configuration
ROD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
ROD_PREFIX=n>>
ROD_ADMIN_ID=YOUR_ADMIN_USER_ID
ROD_ADMIN_IDS=SPACE_SEPARATED_ADMIN_USER_IDS
ROD_INTENT_FEATURES_ENABLE=true
BOT_NAME=Running on Dart
SYNC_COMMANDS=true
ROD_DEBUG=0
ROD_DEV=0
ROD_DEV_GUILD_ID=YOUR_DEV_GUILD_ID
ROD_ADMIN_GUILD=YOUR_ADMIN_GUILD_ID

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=running_on_dart
POSTGRES_DB=running_on_dart
POSTGRES_PASSWORD=CHANGE_ME

# Web server
WEB_SERVER_ENABLE=0
WEB_SERVER_PORT=8088
WEB_SERVER_HOST=0.0.0.0
DISCORD_CLIENT_ID=YOUR_DISCORD_OAUTH_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_OAUTH_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://localhost:8088/redirect
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Home Assistant / Metrics (MQTT)
HOME_ASSISTANT_METRICS_MQTT_ENABLED=0
METRICS_MQTT_PATH=127.0.0.1
METRICS_MQTT_USERNAME=CHANGE_ME
METRICS_MQTT_PASSWORD=CHANGE_ME

# Optional docs/github settings (see README.md for details)
# ROD_DOCS_UPDATE_INTERVAL=900
# ROD_DOCS_PACKAGES="nyxx nyxx_interactions nyxx_commands nyxx_lavalink nyxx_extensions"
# ROD_DEFAULT_DOCS_RESPONSE=...
# ROD_DEFAULT_GITHUB_RESPONSE=...
# ROD_GITHUB_ACCOUNT=nyxx-discord


# Optional GitHub integration
# ROD_GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
